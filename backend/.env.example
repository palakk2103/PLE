# Environment Variables for Appzeto Multi-Vendor Backend
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/appzeto

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_access_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=Peoples League of Electronics
FROM_EMAIL=noreply@peoplesleague.com
SUPPORT_EMAIL=support@peoplesleague.com

# Unpaid online orders are cancelled and their stock released after this many minutes (0 = never)
ABANDONED_PAYMENT_TIMEOUT_MINUTES=30

# Local development only: allows fixed test OTPs such as 123456. Never set this on a server.
ALLOW_DEV_OTP=false

# Local development only (ignored when NODE_ENV=production). Both are off unless set to true.
# SEED_DEMO_DATA creates demo accounts whose passwords are in src/config/db.js.
SEED_DEMO_DATA=false
# ALLOW_DB_FALLBACK lets the server use a local or in-memory database if MONGO_URI is unreachable.
ALLOW_DB_FALLBACK=false
